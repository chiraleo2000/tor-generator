# =============================================================================
# TOR PN — EC2 deploy environment (copy to .env and edit)
# =============================================================================
# Folder: app/infra/pn-ec2/
#   cp .env.example .env
#   # edit changeme / empty required values
#   docker compose -f docker-compose.pn.yml --env-file .env up -d --build
#
# Docs: Discussions/33, 34, 35, 36-AWS-PN-USER-SETUP-AND-RUNBOOK.md
# Region default: ap-southeast-1 | No Fargate | Knowledge store = S3 + S3 Vectors
# On EC2: leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY empty (use instance profile)
# User guide (manual AWS tasks + local→cloud): Discussions/36-AWS-PN-USER-SETUP-AND-RUNBOOK.md
# =============================================================================

COMPOSE_PROJECT_NAME=tor-pn

# -----------------------------------------------------------------------------
# 1) AWS account and region
# -----------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
# Empty on EC2 with IAM instance profile. Dev laptop only if needed:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# -----------------------------------------------------------------------------
# 2) Public host / TLS (nginx on EC2)
# -----------------------------------------------------------------------------
PN_PUBLIC_HOST=changeme.example.go.th
PN_PUBLIC_SCHEME=https
CORS_ORIGINS=https://changeme.example.go.th
COOKIE_SECURE=true
FRONTEND_PORT=3000
BACKEND_PORT=4000
MCP_HOST_PORT=8767
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# 3) App mode — PN cloud on EC2
# -----------------------------------------------------------------------------
DEPLOYMENT_MODE=cloud
PIN_ON_PREM_LLM=false
LLM_PROVIDER=bedrock
EMBEDDING_PROVIDER=bedrock
VECTOR_STORE_PROVIDER=pgvector
RAG_SOURCES=local

# -----------------------------------------------------------------------------
# 4) Bedrock — chat (TOR draft) + embeddings (RAG)
# -----------------------------------------------------------------------------
BEDROCK_REGION=ap-southeast-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# PN locked embedding (Thai / multilingual)
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-v4:0
EMBEDDING_DIMENSIONS=1024
CLOUD_LLM_TIMEOUT=300
LLM_MAX_CONCURRENT=8
EMBEDDING_MAX_CONCURRENT=16
LLM_QUEUE_WAIT_TIMEOUT_SECONDS=120
DRAFT_SECTION_TIMEOUT_SECONDS=300
DRAFT_RAG_TOP_K=8

# -----------------------------------------------------------------------------
# 5) S3 = knowledge objects (MinIO SDK talks to S3)
# -----------------------------------------------------------------------------
PN_S3_BUCKET=changeme-pn-tor-kb
MINIO_ENDPOINT=s3.ap-southeast-1.amazonaws.com
MINIO_BUCKET=changeme-pn-tor-kb
MINIO_SECURE=true
MINIO_REGION=ap-southeast-1
MINIO_USE_IAM=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Layout (see rag-groups.yaml):
#   s3://$PN_S3_BUCKET/rags/{rag_group}/sources/
#   s3://$PN_S3_BUCKET/rags/{rag_group}/manifest/
#   s3://$PN_S3_BUCKET/rags/{rag_group}/chunks/
#   s3://$PN_S3_BUCKET/rags/{rag_group}/drafts/

# -----------------------------------------------------------------------------
# 6) PN multi-RAG / chunk / S3 Vectors
# -----------------------------------------------------------------------------
# Vector bucket is a separate AWS S3 Vectors resource (not the same as object bucket).
PN_S3_VECTOR_BUCKET=changeme-pn-tor-vectors
PN_RETRIEVE_BACKEND=s3_vectors
PN_RAG_GROUPS_PATH=/pn-config/rag-groups.yaml
PN_DEFAULT_RAG_GROUP=procurement-th
PN_CHUNK_TARGET_TOKENS=4096
PN_CHUNK_OVERLAP_TOKENS=384
PN_RETRIEVE_TOP_K=3
PN_RETRIEVE_TOP_K_MAX=5
PN_S3_VECTOR_INDEX_PROCUREMENT=procurement-th-embed4-v1
PN_S3_VECTOR_INDEX_AGENCY=agency-extra-embed4-v1
PN_S3_SOURCES_PREFIX=rags/procurement-th/sources/
PN_DATASET_LOCAL_PATH=

# -----------------------------------------------------------------------------
# 7) MCP (Amazon Quick / Claude Code) — search only
# -----------------------------------------------------------------------------
QUICK_MCP_HOST=0.0.0.0
QUICK_MCP_PORT=8767
QUICK_RAG_MCP_URL=http://mcp-rag:8765/mcp
QUICK_MCP_AUTH_HEADER=Authorization
QUICK_MCP_AUTH_VALUE=changeme_mcp_auth_token

MCP_RAG_ENABLED=true
MCP_RAG_CONFIG_PATH=
MCP_RAG_SERVERS_JSON={"servers":[{"id":"local-pn-mcp","enabled":true,"transport":"http","url":"http://mcp-rag:8765","tool":"retrieve","timeout_seconds":20,"top_k":3}]}
MCP_RAG_TIMEOUT_SECONDS=20
MCP_RAG_AUTH_HEADER=Authorization
MCP_RAG_AUTH_VALUE=

CUSTOM_RAG_ENABLED=false
CUSTOM_RAG_BASE_URL=
CUSTOM_RAG_RETRIEVE_PATH=
CUSTOM_RAG_API_KEY=
CUSTOM_RAG_TOP_K=5
CUSTOM_RAG_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# 8) JWT / browser URLs
# -----------------------------------------------------------------------------
JWT_SECRET=changeme_jwt_secret_at_least_32_characters_long
JWT_EXPIRY_HOURS=24
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_INTERNAL_URL=http://backend:4000/api/v1

# -----------------------------------------------------------------------------
# 9) Local volumes on EC2 only (NOT RDS / ElastiCache)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tor_pn
POSTGRES_USER=tor_pn
POSTGRES_PASSWORD=changeme_postgres_password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
REDIS_TLS=false
MONGO_URI=mongodb://mongo:27017
MONGO_DB=tor_pn_docs
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_neo4j

# -----------------------------------------------------------------------------
# 10) Rate limits
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_UPLOADS_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30

# -----------------------------------------------------------------------------
# 11) AWS console checklist (do once — not env values)
# -----------------------------------------------------------------------------
# [ ] EC2 t3.small/medium + Elastic IP in ap-southeast-1
# [ ] IAM instance profile from iam/ec2-instance-profile.json
# [ ] SG: 443 from office/VPN; prefer SSM over open SSH
# [ ] S3 object bucket = PN_S3_BUCKET (Block Public Access)
# [ ] S3 Vectors vector bucket = PN_S3_VECTOR_BUCKET
# [ ] S3 Vectors indexes dim 1024 matching rag-groups.yaml / PN_S3_VECTOR_INDEX_*
# [ ] Bedrock model access: chat model + cohere.embed-v4:0
# [ ] Smoke: POST /api/v1/pn/kb/upload ingest=true then MCP retrieve
# [ ] AWS Budgets for EC2 + Bedrock + S3
# [ ] cp .env.example .env and replace every changeme_*
# [ ] nginx TLS for PN_PUBLIC_HOST
# [ ] Quick MCP: https://$PN_PUBLIC_HOST/mcp + QUICK_MCP_AUTH_VALUE
