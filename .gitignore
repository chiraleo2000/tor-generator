# =============================================================================
# TOR Drafting and Review Application - .gitignore
# Covers: Python, Node.js, Docker, IDE artifacts
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secrets
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.pytype/

# Alembic
alembic/versions/__pycache__/

# -----------------------------------------------------------------------------
# Node.js / Next.js
# -----------------------------------------------------------------------------
node_modules/
.next/
out/
.nuxt/
dist/

# Package manager locks (keep one)
# Uncomment the ones you don't use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Next.js specific
.next/
.vercel/

# Turborepo
.turbo/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
# Docker Compose override (local dev customizations)
docker-compose.override.yml

# Docker volumes (if stored locally)
docker/volumes/
data/

# -----------------------------------------------------------------------------
# IDE & Editors
# -----------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# OS Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Generated documentation
docs/_build/

# MinIO local data (if running outside Docker)
minio-data/

# Playwright
playwright-report/
test-results/
blob-report/
app/frontend/coverage/

# Original PDF/DOCX source packs — too large for GitHub and not required to run the app
documents/sources/

# Runtime officer/agent uploads and local test caches
app/backend/agent-uploads/
.hypothesis/
.ruff_cache/

# Local IDE / GitHub Actions / Kiro working trees (stay on disk, not in Git)
.cursor/
.github/
.kiro/
