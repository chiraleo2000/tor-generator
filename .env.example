# =============================================================================
# TOR Drafting and Review Application - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Usage: docker compose --env-file .env up
# Project name is required because the repo folder name is Thai (Compose would otherwise be empty).
COMPOSE_PROJECT_NAME=tor-app
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment Mode
# -----------------------------------------------------------------------------
# Options: on_prem, cloud, hybrid
# - on_prem: Local OpenAI-compatible chat + local embeddings (LM Studio / Ollama / llama.cpp)
# - cloud: Claude, OpenAI, or Gemini (requires the matching API key)
# - hybrid: Per-component selection via LLM_PROVIDER, EMBEDDING_PROVIDER, VECTOR_STORE_PROVIDER
# Admin UI settings are stored in Postgres and apply immediately (no backend restart).
# Cloud API keys can be set here as defaults, or entered in Admin > การตั้งค่า AI.
DEPLOYMENT_MODE=on_prem

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tor_app
POSTGRES_USER=tor_user
POSTGRES_PASSWORD=changeme_postgres_password

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# -----------------------------------------------------------------------------
# MinIO (Object Storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET=tor-documents

# -----------------------------------------------------------------------------
# API Keys (Cloud Mode — optional; empty keeps on-prem safe)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Local OpenAI-compatible servers (On-Prem)
# -----------------------------------------------------------------------------
# LM Studio (default): http://127.0.0.1:1234 on the host; Docker uses host.docker.internal
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=google/gemma-4-e4b
LM_STUDIO_EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
LM_STUDIO_TIMEOUT=180
# Ollama OpenAI shim
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# llama.cpp / custom OpenAI-compatible server
LLAMA_CPP_BASE_URL=http://host.docker.internal:8080/v1

# -----------------------------------------------------------------------------
# Cloud model ids (used when LLM_PROVIDER/EMBEDDING_PROVIDER is openai or gemini)
# -----------------------------------------------------------------------------
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# Provider Selection (Hybrid Mode)
# -----------------------------------------------------------------------------
# LLM_PROVIDER: lm_studio, ollama, llama_cpp, claude, openai, gemini
LLM_PROVIDER=lm_studio
# EMBEDDING_PROVIDER: local (preferred), qwen3 (deprecated alias), openai, gemini
EMBEDDING_PROVIDER=local
# VECTOR_STORE_PROVIDER: pgvector, qdrant
VECTOR_STORE_PROVIDER=pgvector

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=changeme_jwt_secret_at_least_32_characters_long
JWT_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# Application Ports
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=4000
# Browser calls same-origin /api/v1 (Next.js rewrite). Do not use http://backend:...
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_INTERNAL_URL=http://backend:4000/api/v1

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_UPLOADS_PER_MINUTE=10

# -----------------------------------------------------------------------------
# Qdrant (Optional - used when VECTOR_STORE_PROVIDER=qdrant)
# -----------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
