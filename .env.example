# =============================================================================
# TOR Drafting and Review Application - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Usage: docker compose --env-file .env up
# Project name is required because the repo folder name is Thai (Compose would otherwise be empty).
COMPOSE_PROJECT_NAME=tor-app
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment Mode
# -----------------------------------------------------------------------------
# Options: on_prem, cloud, hybrid
# Local GPU / LM Studio: DEPLOYMENT_MODE=on_prem + LLM_PROVIDER=lm_studio
# Do not set cloud+bedrock on this workstation — Admin overlay cannot override
# chat when PIN_ON_PREM_LLM=true (Compose default).
# Production on Amazon (AWS-only, no hybrid): DEPLOYMENT_MODE=cloud + LLM_PROVIDER=bedrock
#   See Discussions/24-AWS_CLOUD_OVERVIEW.md and app/infra/aws/env.cloud.example
# Shortcut (EC2 + Compose + Bedrock only): Discussions/20-AWS_BEDROCK_SETUP.md
# Example mix: LLM_PROVIDER=claude + EMBEDDING_PROVIDER=local + ANTHROPIC_API_KEY
# Mode is a label only — it does not swap the other provider.
# Admin UI settings are stored in Postgres and apply immediately (no backend restart).
# Cloud API keys can be set here as defaults, or entered in Admin > การตั้งค่า AI.
DEPLOYMENT_MODE=on_prem

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tor_app
POSTGRES_USER=tor_user
POSTGRES_PASSWORD=changeme_postgres_password

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
# ElastiCache in-transit encryption: REDIS_TLS=true (builds rediss://). Leave unset/false for Compose.
# REDIS_TLS=false

# -----------------------------------------------------------------------------
# MinIO (Object Storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET=tor-documents
# Amazon S3 (AWS-only prod): MINIO_ENDPOINT=s3.ap-southeast-1.amazonaws.com
# MINIO_SECURE=true
# MINIO_REGION=ap-southeast-1
# MINIO_USE_IAM=true
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=

# -----------------------------------------------------------------------------
# API Keys (Cloud Mode — optional; empty keeps on-prem safe)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Local OpenAI-compatible servers (On-Prem) — all remain selectable in Admin
# -----------------------------------------------------------------------------
# LM Studio (dev default): http://127.0.0.1:1234 on the host; Docker uses host.docker.internal
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=google/gemma-4-e4b
LM_STUDIO_EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
# 32k-token TOR drafts / KB answers need a long read timeout
LM_STUDIO_TIMEOUT=1800
# Ollama OpenAI shim
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# llama.cpp / custom OpenAI-compatible server
LLAMA_CPP_BASE_URL=http://host.docker.internal:8080/v1
# SGLang (optional on-prem; Docker profile sglang + NVIDIA GPU)
# One GPU: stop LM Studio Gemma while sglang-llm is running. Chat falls back to
# LM Studio :1234 only when http://sglang-llm:30000/health is down.
# Do not start sglang-embed on the same GPU unless you need to re-seed vectors.
# LLM: docker compose --profile sglang up
# Embeddings (re-seed only): docker compose --profile sglang-embed up
SGLANG_BASE_URL=http://sglang-llm:30000/v1
SGLANG_EMBEDDING_BASE_URL=http://sglang-embed:30001/v1
SGLANG_MODEL=google/gemma-4-e4b
SGLANG_EMBEDDING_MODEL=google/embeddinggemma-300m

# -----------------------------------------------------------------------------
# Cloud model ids (used when LLM_PROVIDER/EMBEDDING_PROVIDER is openai or gemini)
# -----------------------------------------------------------------------------
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# Provider Selection (Hybrid Mode)
# -----------------------------------------------------------------------------
# LLM_PROVIDER: lm_studio, ollama, llama_cpp, sglang, claude, openai, gemini, bedrock, azure_foundry, openai_compatible
# Production Amazon: bedrock  |  Local GPU draft/review: sglang (compose --profile sglang)
# Dev without SGLang: lm_studio — Chat still uses LM Studio when SGLang /health is down
LLM_PROVIDER=lm_studio
# Compose pins this when DEPLOYMENT_MODE=on_prem so Admin cannot switch chat to Bedrock.
PIN_ON_PREM_LLM=true
# EMBEDDING_PROVIDER: none (no pgvector; only Custom RAG/MCP), local, qwen3, openai, gemini, bedrock, azure_foundry, openai_compatible
# Dual local+MCP: only when a real MCP retrieve URL exists. Default local Compose:
# EMBEDDING_PROVIDER=local and RAG_SOURCES=local. Do not use none unless a real PageIndex is configured.
EMBEDDING_PROVIDER=local
# Local embedding host is independent of chat (lm_studio | ollama | llama_cpp | sglang)
LOCAL_EMBEDDING_SERVER=lm_studio
LOCAL_EMBEDDING_BASE_URL=
# VECTOR_STORE_PROVIDER: pgvector, qdrant
VECTOR_STORE_PROVIDER=pgvector

# Custom RAG HTTP (PageIndex or partner retrieve/search; merged with MCP when enabled)
# Accepted: true | false. Default committed: false.
# Compose service `pageindex` is a DEV stub (custom-rag-stub), not a legal index.
# Leave CUSTOM_RAG_ENABLED=false until CUSTOM_RAG_BASE_URL points at a real PageIndex.
CUSTOM_RAG_ENABLED=false
# Real PageIndex in Compose: CUSTOM_RAG_BASE_URL=http://pageindex:8000/api/search
# Host-run PageIndex: CUSTOM_RAG_BASE_URL=http://host.docker.internal:8100/api/search
# Do not enable Custom RAG against the stub: python app/infra/mcp/servers/custom_rag_stub.py
CUSTOM_RAG_BASE_URL=
# Optional path appended to CUSTOM_RAG_BASE_URL. Empty: use /v1/retrieve unless
# the base URL already ends with /api/search, /search, or /v1/retrieve.
CUSTOM_RAG_RETRIEVE_PATH=
CUSTOM_RAG_API_KEY=
CUSTOM_RAG_TOP_K=5
CUSTOM_RAG_TIMEOUT_SECONDS=30
# local | custom | both — on-prem Compose uses local pgvector only
RAG_SOURCES=local
# Phase 3 hybrid pack size after merge (Custom + MCP). Keep small on Bedrock.
DRAFT_RAG_TOP_K=8

# PageIndex Compose service — DEV stub unless you replace the image/command.
# PAGEINDEX_BASE_URL=http://pageindex:8000
# PAGEINDEX_API_KEY=
# PAGEINDEX_INGEST_TIMEOUT_SECONDS=1800
# PAGEINDEX_PORT=8100

# --- MCP RAG (optional extra data source; fail-open, not hybrid LLM) ---
# Enable the MCP RAG client. Accepted: true | false.
# Keep retrieve-stub.enabled=false in rag-sources.yaml until a real agency URL exists.
# docker compose --profile mcp-stub is only for client wiring tests, not legal answers.
MCP_RAG_ENABLED=false
# Local Compose: absolute container path to the mounted rag-sources.yaml.
# ECS uses MCP_RAG_SERVERS_JSON instead — do not set MCP_RAG_CONFIG_PATH on ECS.
MCP_RAG_CONFIG_PATH=/app/infra/mcp/rag-sources.yaml
# ECS/inline: JSON array or {"servers":[...]} (Secrets Manager on cloud).
# If BOTH this and MCP_RAG_CONFIG_PATH are non-empty, the inline JSON WINS.
MCP_RAG_SERVERS_JSON=
# Per-request timeout in seconds (> 0). Default: 20.
MCP_RAG_TIMEOUT_SECONDS=20
# Optional auth header sent on every tools/call. Leave value empty to send NO header.
MCP_RAG_AUTH_HEADER=Authorization
MCP_RAG_AUTH_VALUE=

# Amazon Quick (https://aws.amazon.com/quick/) — workplace assistant connectors, not QuickSight.
# Local sidecar: docker compose --profile amazon-quick up
# MCP endpoint: http://host.docker.internal:8767/mcp
# OpenAPI import: app/infra/quick/openapi-tor.json
# See Discussions/32-AMAZON-QUICK.md (distinct from 31 ECS/Bedrock cloud install).

# -----------------------------------------------------------------------------
# MongoDB (originals) + Neo4j (GraphRAG)
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://mongo:27017
MONGO_DB=tor_docs
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_neo4j

# -----------------------------------------------------------------------------
# Amazon Bedrock (AWS-only prod: Discussions/24–27; EC2+Compose shortcut: 20)
# Leave AWS keys empty on ECS to use the task IAM role.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional Bedrock API key (bearer). Not an access/secret pair. Empty = IAM/keys.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=ap-southeast-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Cloud LLM read timeout in seconds (Bedrock Converse). Default: 300.
CLOUD_LLM_TIMEOUT=300
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=
AZURE_FOUNDRY_EMBEDDING_DEPLOYMENT=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=changeme_jwt_secret_at_least_32_characters_long
JWT_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# Application Ports
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=4000
# Browser calls same-origin /api/v1 (Next.js rewrite). Do not use http://backend:...
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_INTERNAL_URL=http://backend:4000/api/v1

# -----------------------------------------------------------------------------
# Rate Limiting + LLM admission queue
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_UPLOADS_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
# Bedrock: 8–16 OK; on-prem GPU / LM Studio: keep 1
LLM_MAX_CONCURRENT=1
EMBEDDING_MAX_CONCURRENT=16
LLM_QUEUE_WAIT_TIMEOUT_SECONDS=120
# Per-section Phase 3 draft cap (seconds). Local Gemma compose often needs 4–5 minutes.
DRAFT_SECTION_TIMEOUT_SECONDS=300

# -----------------------------------------------------------------------------
# Qdrant (Optional - used when VECTOR_STORE_PROVIDER=qdrant)
# -----------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
