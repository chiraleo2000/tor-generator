# =============================================================================
# TOR Generator — copy to .env and fill in secrets. Do not commit real keys.
# Layout and non-secret defaults match the local .env.
# =============================================================================
COMPOSE_PROJECT_NAME=tor-app
DEPLOYMENT_MODE=on_prem
FRONTEND_PORT=3000
BACKEND_PORT=4000
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_INTERNAL_URL=http://backend:4000/api/v1

# ----------------------------------------------------------------------------
# Chat / draft / review: Amazon Bedrock. Embeddings stay on local LM Studio
# so the existing pgvector index is reused (a Bedrock embed model would
# require embedding the knowledge base again).
# PIN_ON_PREM_LLM must stay false; true forces chat back to LM Studio.
# ----------------------------------------------------------------------------
LLM_PROVIDER=bedrock
# Optional chat failover. Leave unset in this file. Enable only in .env.bedrock:
# LLM_FALLBACK_PROVIDER=gemini
PIN_ON_PREM_LLM=false
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
CLOUD_LLM_TIMEOUT=10800

# RAG A — local pgvector KB (required). EmbeddingGemma via LM Studio.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_SERVER=lm_studio
LOCAL_EMBEDDING_BASE_URL=
VECTOR_STORE_PROVIDER=pgvector
RAG_SOURCES=local

# RAG B — Custom RAG / PageIndex. Off until BASE_URL is a real index (Compose
# service `pageindex` is a DEV stub that returns custom-rag-stub chunks).
CUSTOM_RAG_ENABLED=false
CUSTOM_RAG_BASE_URL=
CUSTOM_RAG_RETRIEVE_PATH=
CUSTOM_RAG_API_KEY=
CUSTOM_RAG_TOP_K=5
CUSTOM_RAG_TIMEOUT_SECONDS=30
PAGEINDEX_BASE_URL=
PAGEINDEX_API_KEY=
PAGEINDEX_INGEST_TIMEOUT_SECONDS=10800
PAGEINDEX_PORT=8100

# RAG C — MCP retrieve (JSON-RPC). Client on; servers in rag-sources.yaml.
# retrieve-stub must stay enabled: false until a real agency URL exists.
MCP_RAG_ENABLED=true
MCP_RAG_CONFIG_PATH=/app/infra/mcp/rag-sources.yaml
MCP_RAG_SERVERS_JSON=
MCP_RAG_TIMEOUT_SECONDS=20
MCP_RAG_AUTH_HEADER=Authorization
MCP_RAG_AUTH_VALUE=

# Infra (Windows: host 5432 unless occupied)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tor_app
POSTGRES_USER=tor_user
POSTGRES_PASSWORD=changeme_postgres_password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET=tor-documents

MONGO_URI=mongodb://mongo:27017
MONGO_DB=tor_docs
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_neo4j

JWT_SECRET=changeme_jwt_secret_at_least_32_characters_long
JWT_EXPIRY_HOURS=24
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_UPLOADS_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
LLM_MAX_CONCURRENT=1
LLM_QUEUE_WAIT_TIMEOUT_SECONDS=720
DRAFT_SECTION_TIMEOUT_SECONDS=10800

QDRANT_HOST=qdrant
QDRANT_PORT=6333

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=google/gemma-4-e4b
LM_STUDIO_EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
# Local pair only — Gemma 4 131k chat + EmbeddingGemma 768-d via LM Studio :1234.
TOR_CONTEXT_WINDOW=131072
TOR_SECTION_MAX_TOKENS=32768
TOR_SCOPE_SUB_MAX_TOKENS=8192
TOR_CHAT_MAX_TOKENS=32768
TOR_REVIEW_MAX_TOKENS=131072
TOR_REVIEW_ANALYZE_MAX_TOKENS=65536
EMBEDDING_MAX_TOKENS=2048
EMBEDDING_DIMENSIONS=768
LM_STUDIO_TIMEOUT=10800
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
LLAMA_CPP_BASE_URL=http://host.docker.internal:8080/v1
SGLANG_MODEL=google/gemma-4-e4b
SGLANG_EMBEDDING_MODEL=google/embeddinggemma-300m
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_MODEL=gemini-3.5-flash-lite

# PageIndex sidecar only (not TOR Settings). Rotate if exposed.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview
DRAFT_RAG_TOP_K=8

# -----------------------------------------------------------------------------
# Web search (Tavily or Brave). A Tavily or Brave API key is required.
# Bedrock credits do not cover web search. Empty key skips online search.
# -----------------------------------------------------------------------------
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_MIN_RESULTS=5
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_TIMEOUT_SECONDS=20
